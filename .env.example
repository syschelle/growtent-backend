# GrowTent / CanopyOps deployment environment template
# Copy this file to .env and replace every REPLACE_WITH_* value before starting Docker Compose.
# Do not commit your real .env file.

POSTGRES_DB=growtent
POSTGRES_USER=growtent_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DATABASE_PASSWORD

# Must match the database settings above. URL-encode special characters in the password.
DATABASE_URL=postgresql://growtent_app:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@db:5432/growtent

# First-run install bootstrap protection. Required by default.
# Use a long random value, for example: openssl rand -base64 48
INSTALL_API_ENABLED=true
INSTALL_API_REQUIRE_TOKEN=true
INSTALL_API_TOKEN=REPLACE_WITH_STRONG_RANDOM_INSTALL_TOKEN

# Optional runtime settings
POLL_INTERVAL_SECONDS=10
RETENTION_DAYS=7

# Optional image overrides. Keep go2rtc pinned to a tested version/digest unless you intentionally test another image.
GT_API_IMAGE=ghcr.io/syschelle/growtent-backend-api:latest
GO2RTC_IMAGE=alexxit/go2rtc:1.9.14@sha256:f0579db234b4f9e8630493777dbf8581630d5d942d27b884ac9186f3d688e7bf

# Security hardening
SESSION_COOKIE_SECURE=true
PROJECT_DOWNLOAD_ENABLED=false
GT_API_BIND_ADDRESS=127.0.0.1
# v0.414: Only enter the exact Traefik reverse-proxy source IP/CIDR(s).
# Example for a dedicated trusted proxy: GT_TRUSTED_PROXY_CIDRS=172.20.0.2/32
# Leave empty when unknown; this never trusts arbitrary X-Forwarded-For headers.
# With an empty value, login limits use the immediate TCP peer (possibly Traefik).
GT_TRUSTED_PROXY_CIDRS=
# Set SESSION_COOKIE_SECURE=false only for intentional plain-HTTP local access.

# v0.411: maximum lifetime of a fresh admin confirmation (seconds, clamped to 30–300).
# Current password and, when enabled, TOTP are required on sensitive admin actions.
# STEP_UP_TTL_SECONDS=300

# v0.413 – required for production Docker deployments.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER change or lose this key after migration: DB secrets and encrypted backups depend on it.
# Do not add this key to Git or into a configuration backup. Save it offline securely.
GT_DATA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
