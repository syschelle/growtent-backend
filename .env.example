# GrowTent / CanopyOps deployment environment template
# Copy this file to .env and replace every REPLACE_WITH_* value before starting Docker Compose.
# Do not commit your real .env file.

POSTGRES_DB=growtent
POSTGRES_USER=growtent_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DATABASE_PASSWORD

# Must match the database settings above. URL-encode special characters in the password.
DATABASE_URL=postgresql://growtent_app:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@db:5432/growtent

# First-run install bootstrap protection. Required by default.
# Use a long random value, for example: openssl rand -base64 48
INSTALL_API_ENABLED=true
INSTALL_API_REQUIRE_TOKEN=true
INSTALL_API_TOKEN=REPLACE_WITH_STRONG_RANDOM_INSTALL_TOKEN

# Optional runtime settings
POLL_INTERVAL_SECONDS=10
RETENTION_DAYS=7

# Optional image overrides. Keep go2rtc pinned to a tested version/digest unless you intentionally test another image.
GT_API_IMAGE=ghcr.io/syschelle/growtent-backend-api:v0.262
GO2RTC_IMAGE=alexxit/go2rtc:1.9.14@sha256:f0579db234b4f9e8630493777dbf8581630d5d942d27b884ac9186f3d688e7bf
